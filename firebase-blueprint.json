{
  "entities": {
    "inquiry": {
      "title": "Contact Inquiry",
      "description": "A message sent from the contact form.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The name of the sender." },
        "email": { "type": "string", "format": "email", "description": "The email of the sender." },
        "phone": { "type": "string", "description": "The phone number of the sender." },
        "product": { "type": "string", "description": "The product the user is interested in." },
        "message": { "type": "string", "description": "The message content." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the inquiry was sent." }
      },
      "required": ["name", "phone", "message", "createdAt"]
    }
  },
  "firestore": {
    "/inquiries/{inquiryId}": {
      "schema": "inquiry",
      "description": "Collection of contact form inquiries."
    }
  }
}
